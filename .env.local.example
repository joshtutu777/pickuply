# Pickuply environment variables.
# Copy this file to .env.local and fill in real values there.
# Do not put real keys in this file. .env.local is gitignored.
#
# docs/SPEC.md was not in the repository during Step 1.
# These names cover the services named for later steps:
# Supabase (database, phone sign-in, storage, realtime),
# Stripe card holds with manual capture (Connect payouts are v2),
# Twilio SMS, and Web Push.
# Nothing here is connected yet.

# Public site URL. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Beta badge and Send Feedback. Set to false to hide them. Anything else, including a blank value, stays on.
# This is not the Stripe mode.
NEXT_PUBLIC_BETA_MODE=true
NEXT_PUBLIC_APP_VERSION=beta

# Supabase — database, phone sign-in, storage, realtime.
# Step 3a uses the URL and anon key. The service-role key is unused until a later step.
# Use the project URL only, such as https://YOUR_PROJECT.supabase.co.
# Do not add /rest/v1. That path is the Data API, and phone sign-in would miss Auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Required before checkout can record a Stripe session, and before
# webhooks, capture, transfers, cron, and STOP handling can run.
# Never expose this in the browser or in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Bearer token for /api/cron/*. Server only.
CRON_SECRET=

# Stripe — authorize a card up front, capture only after delivery.
# .env.local keeps one live secret and one live publishable key.
# Test copies use STRIPE_TEST_SECRET_KEY and NEXT_PUBLIC_STRIPE_TEST_PUBLISHABLE_KEY.
# The local test process reads .env.test.local, where the standard names are test keys.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_TEST_SECRET_KEY=
NEXT_PUBLIC_STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_LIVE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Optional Connect platform id. Driver accounts are created with the secret key.
STRIPE_CONNECT_CLIENT_ID=

# Twilio SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Web Push (VAPID). The service worker comes in a later step.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Address search. Server only. Leave empty to search Georgia cities and ZIPs, and allow a typed address.
GOOGLE_PLACES_API_KEY=

# Browser maps. Public. Restricted to the Maps JavaScript API.
# Standard markers do not need a Map ID. Add NEXT_PUBLIC_GOOGLE_MAP_ID only if we switch to Advanced Markers.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Driving miles. Server only. Leave empty to label distances as straight-line.
# This is not a Google API. Do not send it coordinates that came from Google Places.
OPENROUTESERVICE_API_KEY=

# Playwright phone sign-in. Leave these empty here.
# Put dashboard test numbers only in .env.local or .env.test. Both are gitignored.
TEST_PHONE=
TEST_OTP=
TEST_ADMIN_PHONE=
TEST_ADMIN_OTP=

# Hosted test phones 5555550301-5555550313. Six digits each. Leave empty here.
# Put the codes only in gitignored .env.local. Do not commit them.
PICKUPLY_TEST_OTP_0301=
PICKUPLY_TEST_OTP_0302=
PICKUPLY_TEST_OTP_0303=
PICKUPLY_TEST_OTP_0304=
PICKUPLY_TEST_OTP_0305=
PICKUPLY_TEST_OTP_0306=
PICKUPLY_TEST_OTP_0307=
PICKUPLY_TEST_OTP_0308=
PICKUPLY_TEST_OTP_0309=
PICKUPLY_TEST_OTP_0310=
PICKUPLY_TEST_OTP_0311=
PICKUPLY_TEST_OTP_0312=
PICKUPLY_TEST_OTP_0313=
