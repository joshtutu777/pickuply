# Isolated local Stripe TEST runtime. Copy to .env.test.local and fill from the
# test-mode Dashboard. Do not put live keys in this file. .env.local keeps the
# live secret and live publishable key under those names. The test copies in
# .env.local use STRIPE_TEST_SECRET_KEY and NEXT_PUBLIC_STRIPE_TEST_PUBLISHABLE_KEY
# so a later live line cannot hide them.
#
# Start the app with:
# node scripts/stripe-test-runtime.mjs .env.test.local npx next dev -p 3011

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
